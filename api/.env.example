# ---------------------------------------------------------------- required

# Postgres 15 or newer. On Vercel use a pooled connection string.
DATABASE_URL=postgresql://okmeme:okmeme@localhost:5432/okmeme

# Where this API is reachable from the outside. Used for absolute URLs.
PUBLIC_URL=http://localhost:8787

# Origins allowed to send credentialed requests. Comma-separated.
# This is the SPA's origin, not the API's.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- ports
#
# Every backend service sits behind a port with at least two implementations,
# so moving between Vercel and a box you own is a change of these values.

# local | supabase
AUTH_PROVIDER=local

# local-fs | s3 | supabase-storage | none
#
# `none` runs the instance with no thumbnails and no favicons at all: nothing is
# fetched, nothing is stored, and links render with a tinted host letter. It
# never falls back to loading the image from the site it points at — that would
# hand every viewer's IP to whoever hosts it, which in a tiered system is a way
# to count the readers below you.
#
# For a free store, Cloudflare R2 speaks S3 and has no egress fees. See DEPLOY.md.
BLOB_STORE=local-fs

# ---------------------------------------------------------------- bootstrap

# Unlocks the one-time /setup page, which creates the owner and the admin.
# It stops working the moment settings.setup_complete is true, so a leaked
# token on a live instance is inert. Leave unset on deployments that use
# `okmeme init` instead.
SETUP_TOKEN=

# ---------------------------------------------------------------- sessions

COOKIE_NAME=okm_session
# Set when the API and the SPA are on different subdomains of one site.
COOKIE_DOMAIN=
# Defaults to true in production. Must be true for cross-site cookies.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- blob: local-fs

BLOB_DIR=./.blobs

# ---------------------------------------------------------------- blob: s3
# Works with S3, R2, B2, MinIO and Spaces.

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------- supabase
# Needed by AUTH_PROVIDER=supabase, BLOB_STORE=supabase-storage, or both.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=okmeme
# okmeme has no email and GoTrue insists on one. Usernames map to synthetic
# addresses under this domain. Nothing is ever delivered to it.
SUPABASE_USER_DOMAIN=users.okmeme.invalid

# ---------------------------------------------------------------- fetching

# The server fetches preview images so a viewer's browser never touches a
# third-party host. Guard rails on that fetch:
MAX_FETCH_BYTES=5242880
FETCH_TIMEOUT_MS=8000
# Local development only. Never set this in production: it turns the link
# fetcher into a server-side request forgery primitive.
ALLOW_PRIVATE_FETCH=false

# ---------------------------------------------------------------- misc

PORT=8787
NODE_ENV=development
# Behind a proxy the client IP comes from a header rather than the socket.
TRUST_PROXY=true
# Salts the IP hashes used for anonymous rate limiting and recovery requests.
# Change it and every anonymous bucket resets. Keep it secret and stable.
IP_SALT=change-me
