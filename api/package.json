{
  "name": "@okmeme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "okmeme": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/lib/migrate-cli.ts",
    "init": "tsx --env-file-if-exists=.env src/cli.ts init",
    "generate": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@prisma/client": "^6.5.0",
    "hash-wasm": "^4.12.0",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true
  }
}
