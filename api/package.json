{
  "name": "@okmeme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "okmeme": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/lib/migrate-cli.ts",
    "init": "tsx --env-file-if-exists=.env src/cli.ts init",
    "generate": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
