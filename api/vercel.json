{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
